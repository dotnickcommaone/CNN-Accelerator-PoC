        <mxCell id="t-load" value="LOAD STAGE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DDR → BRAM tiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="205" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="t-acc" value="MobileNetV2-0.35 INT8 Accelerator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Depthwise 3×3 engine&lt;br&gt;Pointwise 1×1 engine&lt;br&gt;INT32 accumulate + ReLU6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D2E9;strokeColor=#674EA7;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="880" y="335" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="t-bram" value="On-chip BRAM&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Line buffer • Feature tiles&lt;br&gt;Weight tiles • Ping-pong buffers&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="350" width="75" height="100" as="geometry"/></mxCell>
