        <mxCell id="t-pre" value="Pre-processing&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Resize 160×160 • RGB&lt;br&gt;Normalize / Quantize INT8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="555" y="205" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="t-pynq-driver" value="PYNQ Driver&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Buffer allocation&lt;br&gt;AXI register control&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="345" width="170" height="90" as="geometry"/></mxCell>
