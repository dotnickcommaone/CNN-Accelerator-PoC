  <diagram id="thesis-experiment" name="05 - Quy trình thực nghiệm">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="x-title" value="QUY TRÌNH HUẤN LUYỆN VÀ THỰC NGHIỆM" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="300" y="45" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="x-data" value="1. DỮ LIỆU&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Synthetic + webcam&lt;br&gt;auto-label YOLO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="310" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="x-train" value="2. HUẤN LUYỆN&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;MobileNetV2-0.35&lt;br&gt;FP32 checkpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="310" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="x-eval" value="3. ĐÁNH GIÁ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Precision, Recall, F1&lt;br&gt;AP50 và latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="555" y="310" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="x-export" value="4A. EXPORT INT8&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Nhánh handoff FPGA&lt;br&gt;ONNX + NPZ + manifest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F1EDF7;strokeColor=#8064A2;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="810" y="310" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="x-run" value="4B. CHẠY POC&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Classical / CNN / Hybrid&lt;br&gt;nhiều trial độc lập&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1075" y="310" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="x-prism" value="5. PHÂN TÍCH&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;CSV / TSV cho Prism&lt;br&gt;bảng và biểu đồ luận văn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1340" y="310" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="x-metrics" value="CHỈ TIÊU THỰC NGHIỆM&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;AP50 • tỷ lệ fallback • model latency • end-to-end latency • FPS&lt;br&gt;tỷ lệ hoàn tất nhiệm vụ • sai số vị trí dừng • tài nguyên và công suất FPGA khi có board&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#44546A;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="360" y="570" width="880" height="115" as="geometry"/></mxCell>
        <mxCell id="x-note" value="Số liệu dummy chỉ dùng kiểm tra pipeline trình bày; kết quả khóa luận phải thay bằng dữ liệu đo thực tế." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="445" y="730" width="710" height="60" as="geometry"/></mxCell>
        <mxCell id="x-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B9BD5;" edge="1" parent="1" source="x-data" target="x-train"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#8064A2;" edge="1" parent="1" source="x-train" target="x-eval"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x-e3" value="INT8 handoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#8064A2;fontSize=11;" edge="1" parent="1" source="x-eval" target="x-export"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="x-e4" value="accepted FP32 checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=11;" edge="1" parent="1" source="x-eval" target="x-run"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="250"/><mxPoint x="1175" y="250"/></Array></mxGeometry></mxCell>
