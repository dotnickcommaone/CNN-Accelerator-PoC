  <diagram id="thesis-mission" name="03 - State machine khứ hồi">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="m-title" value="STATE MACHINE NHIỆM VỤ KHỨ HỒI" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="m-wait" value="WAITING_FOR_START&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Xác nhận marker khởi điểm&lt;br&gt;robot đứng yên&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="95" y="195" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="m-out" value="OUTBOUND&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Tiến đến marker đích&lt;br&gt;giảm tốc khi tới gần&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="145" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="m-target" value="AT_TARGET&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Dừng tại phòng đích&lt;br&gt;chờ dwell frames&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="980" y="195" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="m-turn" value="TURNING_HOME&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Quay tại chỗ 180°&lt;br&gt;theo số frame cấu hình&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="m-return" value="RETURNING&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Quay về marker khởi điểm&lt;br&gt;giảm tốc khi tới gần&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="690" y="590" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="m-home" value="HOME_COMPLETE&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Dừng tại điểm ban đầu&lt;br&gt;khóa motor đến khi reset&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="225" y="520" width="240" height="125" as="geometry"/></mxCell>
        <mxCell id="m-e1" value="start ID đủ N frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B9BD5;fontSize=12;" edge="1" parent="1" source="m-wait" target="m-out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e2" value="target đủ gần N frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=12;" edge="1" parent="1" source="m-out" target="m-target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e3" value="hết dwell frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#ED7D31;fontSize=12;" edge="1" parent="1" source="m-target" target="m-turn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e4" value="quay đủ turn frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#ED7D31;fontSize=12;" edge="1" parent="1" source="m-turn" target="m-return"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e5" value="start đủ gần N frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=12;" edge="1" parent="1" source="m-return" target="m-home"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m-e6" value="reset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#7F8C8D;fontSize=12;" edge="1" parent="1" source="m-home" target="m-wait"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="thesis-fpga" name="04 - Kiến trúc FPGA đích">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="f-title" value="KIẾN TRÚC PHẦN CỨNG / PHẦN MỀM ĐÍCH TRÊN PYNQ-Z2" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="250" y="35" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="f-camera" value="CAMERA&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;USB / OV2640&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="155" height="95" as="geometry"/></mxCell>
        <mxCell id="f-board" value="PYNQ-Z2 / ZYNQ-7020" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#FAFAFA;strokeColor=#44546A;strokeWidth=2;fontStyle=1;fontSize=17;fontColor=#203864;" vertex="1" parent="1"><mxGeometry x="235" y="135" width="1100" height="600" as="geometry"/></mxCell>
        <mxCell id="f-ps-zone" value="PROCESSING SYSTEM - ARM CORTEX-A9" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#FFF7E6;strokeColor=#ED7D31;fontStyle=1;fontColor=#843C0C;" vertex="1" parent="1"><mxGeometry x="275" y="205" width="470" height="470" as="geometry"/></mxCell>
        <mxCell id="f-pl-zone" value="PROGRAMMABLE LOGIC - FPGA" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;dashed=1;fillColor=#F1EDF7;strokeColor=#8064A2;strokeWidth=2;fontStyle=1;fontColor=#4C386B;" vertex="1" parent="1"><mxGeometry x="790" y="205" width="500" height="470" as="geometry"/></mxCell>
        <mxCell id="f-capture" value="Camera capture&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;OpenCV / V4L2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="285" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="f-pre" value="Pre-processing&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Resize + INT8 quantize&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=13;" vertex="1" parent="1"><mxGeometry x="535" y="285" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="f-post" value="Post-processing&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;NMS + ArUco + pose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="495" width="180" height="85" as="geometry"/></mxCell>
        <mxCell id="f-control" value="Mission controller&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Start → Target → Start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=13;" vertex="1" parent="1"><mxGeometry x="535" y="495" width="170" height="85" as="geometry"/></mxCell>
        <mxCell id="f-dma" value="AXI DMA&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DDR ↔ BRAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#DDEBF7;strokeColor=#8064A2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="285" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="f-acc" value="CNN ACCELERATOR INT8&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;MobileNetV2-0.35&lt;br&gt;Depthwise + pointwise conv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=3;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1050" y="365" width="205" height="110" as="geometry"/></mxCell>
        <mxCell id="f-buffer" value="BRAM buffers&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Feature-map tiles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#DDEBF7;strokeColor=#8064A2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="835" y="495" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="f-robot" value="ROBOT VẬT LÝ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;UART / GPIO&lt;br&gt;motor driver&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1390" y="360" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="f-note" value="Kiến trúc đích phục vụ thiết kế luận văn; chưa được tổng hợp hoặc đo đạc trên board trong PoC hiện tại." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8064A2;dashed=1;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="420" y="775" width="760" height="65" as="geometry"/></mxCell>
