  <diagram id="thesis-overview" name="01 - Tổng quan PoC">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="o-title" value="KIẾN TRÚC TỔNG QUAN POC HIỆN TẠI" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="300" y="45" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="o-sub" value="Nhận diện marker ArUco cho robot giao hàng indoor bằng USB webcam và Python" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#5B6573;" vertex="1" parent="1"><mxGeometry x="350" y="95" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="o-env" value="MÔI TRƯỜNG INDOOR&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Marker khởi điểm và marker đích&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="185" height="105" as="geometry"/></mxCell>
        <mxCell id="o-camera" value="USB WEBCAM&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Khung hình thời gian thực&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="335" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="o-detect" value="PHÁT HIỆN MARKER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Classical / CNN / Hybrid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="475" y="335" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="o-decode" value="GIẢI MÃ ARUCO&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ID và bốn góc marker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="335" width="185" height="105" as="geometry"/></mxCell>
        <mxCell id="o-pose" value="KHOẢNG CÁCH&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pose / kích thước pixel&lt;br&gt;lọc theo thời gian&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="335" width="185" height="105" as="geometry"/></mxCell>
        <mxCell id="o-control" value="ĐIỀU KHIỂN NHIỆM VỤ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Start → Target → Start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="335" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="o-output" value="ĐẦU RA POC&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Lệnh robot mô phỏng&lt;br&gt;UI, video và CSV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1365" y="335" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="o-note" value="Phần mềm PoC đã triển khai trên laptop; FPGA và robot vật lý chưa được tích hợp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F8C8D;dashed=1;fontSize=13;fontStyle=2;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="430" y="555" width="740" height="65" as="geometry"/></mxCell>
        <mxCell id="o-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B9BD5;" edge="1" parent="1" source="o-env" target="o-camera"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o-e2" value="frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B9BD5;fontSize=11;" edge="1" parent="1" source="o-camera" target="o-detect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o-e3" value="ROI / frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=11;" edge="1" parent="1" source="o-detect" target="o-decode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o-e4" value="ID + corners" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=11;" edge="1" parent="1" source="o-decode" target="o-pose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o-e5" value="observation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#ED7D31;fontSize=11;" edge="1" parent="1" source="o-pose" target="o-control"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="o-e6" value="state + command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#BF9000;fontSize=11;" edge="1" parent="1" source="o-control" target="o-output"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="thesis-vision" name="02 - Pipeline nhận diện">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v-title" value="PIPELINE NHẬN DIỆN MARKER TRONG POC" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="v-input" value="KHUNG HÌNH&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;BGR từ OpenCV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="55" y="350" width="175" height="95" as="geometry"/></mxCell>
        <mxCell id="v-mode" value="CHẾ ĐỘ&lt;br&gt;NHẬN DIỆN" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="295" y="337" width="150" height="120" as="geometry"/></mxCell>
        <mxCell id="v-classical" value="CLASSICAL&lt;br&gt;&lt;b&gt;OpenCV ArUco&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Xử lý toàn khung hình&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="215" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="v-cnn" value="CNN / HYBRID&lt;br&gt;&lt;b&gt;MobileNetV2-0.35&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RGB 160 × 160&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="205" height="110" as="geometry"/></mxCell>
        <mxCell id="v-post" value="HẬU XỬ LÝ CNN&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Decode grid + NMS&lt;br&gt;crop ROI và padding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="800" y="480" width="205" height="110" as="geometry"/></mxCell>
        <mxCell id="v-decode" value="GIẢI MÃ ARUCO&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Marker ID + bốn góc&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="345" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="v-output" value="KẾT QUẢ&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ID, bounding box&lt;br&gt;khoảng cách / pose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1360" y="345" width="185" height="105" as="geometry"/></mxCell>
        <mxCell id="v-note" value="Hybrid: nếu CNN không tạo ROI giải mã được, hệ thống fallback sang OpenCV ArUco toàn khung hình." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8064A2;dashed=1;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="690" height="65" as="geometry"/></mxCell>
        <mxCell id="v-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B9BD5;" edge="1" parent="1" source="v-input" target="v-mode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e2" value="classical" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=11;" edge="1" parent="1" source="v-mode" target="v-classical"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e3" value="cnn / hybrid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#8064A2;fontSize=11;" edge="1" parent="1" source="v-mode" target="v-cnn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#8064A2;" edge="1" parent="1" source="v-cnn" target="v-post"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e5" value="ROI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#8064A2;fontSize=11;" edge="1" parent="1" source="v-post" target="v-decode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e6" value="full frame" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#70AD47;fontSize=11;" edge="1" parent="1" source="v-classical" target="v-decode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#5B9BD5;" edge="1" parent="1" source="v-decode" target="v-output"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v-e8" value="fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#8064A2;fontSize=11;" edge="1" parent="1" source="v-post" target="v-classical"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="165"/><mxPoint x="620" y="165"/></Array></mxGeometry></mxCell>
      </root>
